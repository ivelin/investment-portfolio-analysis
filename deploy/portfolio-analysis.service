[Unit]
Description=Portfolio Analysis continuous service (scheduler + MCP HTTP)
Documentation=file:///home/openclaw/investment-portfolio-analysis/docs/Jobs_And_Service.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/investment-portfolio-analysis
EnvironmentFile=-%h/.env
Environment=PORTFOLIO_ANALYSIS_HOME=%h/.investment-portfolio-analysis
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=3460
Environment=PORTFOLIO_ANALYSIS_TZ=America/Chicago
ExecStart=%h/investment-portfolio-analysis/.venv/bin/python -m portfolio_analysis.service --mcp-http --host 127.0.0.1 --port 3460
Restart=always
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio-analysis
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
