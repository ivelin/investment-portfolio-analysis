output/
reports/

# Local portfolio data, broker tokens, and secrets (never commit)
# Canonical instance home: dot + repo dir name
.investment-portfolio-analysis/
**/.investment-portfolio-analysis/
# Legacy instance home (pre public-repo rename)
.portfolio-analysis/
**/.portfolio-analysis/
**/portfolio.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3
.schwab/
**/.schwab/
**/tokens.json
**/token.json
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
client_secret*.json
secrets/
# Unredacted personal export dumps (also covered by *.csv/*.xml/*.pdf above)
# Never force-add real brokerage/tax exports into tests/fixtures/exports/
tests/fixtures/exports/**/*.PDF
tests/fixtures/exports/**/*.pdf
# Accidental nested home-dir copies inside the worktree
~/

# Ruff (linter cache - appears when running ruff locally)
.ruff_cache/

# Generated report artifacts / ad-hoc report outputs
# Report tools should write to user-writable locations (e.g. ~/.../reports/ or reports/ which is already ignored)
# or take explicit --output paths outside the source tree. Never commit these.
coverage_report_*.csv
*report*.csv
*report*.txt
*report*.pdf
*detailed*twrr*.txt
twrr_report*.*
# Ad-hoc chart PNGs dropped in the worktree (use instance reports/ instead)
*_twrr*.png
*_twrr_ohlc*.png
*_chart*.png
# Keep the reusable CLI helper (not a generated artifact)
!tools/twrr_report.py
ytd_report*.*
aapl*report*.*
weed*report*.*
web/node_modules/
