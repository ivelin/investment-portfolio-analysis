# Copy to .env.local (gitignored) for local overrides.
# On Vercel: set keys in Project → Settings → Environment Variables.

# ── Direct Google / X (Vercel product path; optional in Grok sandbox) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Session signing (required on Vercel; optional locally)
BETTER_AUTH_SECRET=

# Neon Postgres (required on Vercel; optional locally — PGLite without it)
DATABASE_URL=

# Optional fixed Better Auth base URL
# BETTER_AUTH_URL=https://your-app.vercel.app

# Grok broker is ON by default for non-Vercel (sandbox / CLI).
# Set true to disable broker when you have no social env either.
# AUTH_DISABLE_GROK_BROKER=true
