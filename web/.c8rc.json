{
  "all": true,
  "include": [
    "src/lib/portfolio/**/*.ts",
    "src/lib/security/**/*.ts",
    "src/lib/compliance/**/*.ts",
    "src/lib/db.ts",
    "src/lib/db-url.ts",
    "src/lib/runtime-env.ts",
    "src/lib/auth/auth-runtime-status.ts",
    "src/lib/auth/social-config.ts",
    "src/lib/auth/providers.ts",
    "src/routes/api/**/*.ts"
  ],
  "exclude": [
    "src/routeTree.gen.ts",
    "src/components/**",
    "src/routes/*.tsx",
    "src/routes/api/auth/**",
    "src/lib/multiplayer/**",
    "src/lib/auth/client.ts",
    "src/lib/auth/provider.tsx",
    "src/lib/auth/gates.tsx",
    "src/lib/auth/popup.server.ts",
    "src/lib/auth/use-current-user.ts",
    "src/lib/auth/email-password.ts",
    "src/lib/auth/preview.ts",
    "src/lib/auth/pglite-dialect.ts",
    "src/lib/auth/isolation.server.ts",
    "src/lib/auth/middleware.ts",
    "src/lib/auth/server.ts",
    "src/lib/auth/verify.server.ts",
    "src/lib/auth/auth-status-queries.ts",
    "src/lib/portfolio/api-key-queries.ts",
    "src/lib/portfolio/connector-queries.ts",
    "src/lib/portfolio/queries.ts",
    "src/lib/portfolio/types.ts",
    "src/lib/compliance/legal-queries.ts",
    "src/lib/utils.ts",
    "**/*.tsx"
  ],
  "reporter": ["text", "text-summary", "json-summary", "lcov"],
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "branches": 55,
  "functions": 60,
  "skip-full": false,
  "temp-directory": "./coverage/tmp",
  "report-dir": "./coverage"
}
